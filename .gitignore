# Crafted output, at the repo root only. An unanchored "out/" also matches
# web/app/api/out/, which silently un-tracks the route that serves these files.
/out/

.env*
__pycache__/
node_modules/

# The template is meant to be committed; it must come after every .env rule,
# because in gitignore the last matching rule wins.
!.env.example
