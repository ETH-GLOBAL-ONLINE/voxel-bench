# Copy to .env at the repo root. Gitignored — never commit the real one.

# The model that writes recipes. Free tier at aistudio.google.com.
GEMINI_API_KEY=

# Optional fallback. console.groq.com, also free. Faster and less consistent:
# it does not enforce a schema server-side, so more attempts fail validation.
# GROQ_API_KEY=
# VOXEL_LLM_PROVIDER=groq

# A second route, tried once when the first gives up — Gemini's free tier
# answers 503 when demand spikes. One key at openrouter.ai covers many models.
# OPENROUTER_API_KEY=
# VOXEL_LLM_FALLBACK=openrouter:google/gemini-2.5-flash-lite

# Only needed to publish from the terminal. The site asks each user for their
# own key instead, and never stores it.
# ROBLOX_API_KEY=
# ROBLOX_USER_ID=

# Lets /publish fall back to the key above when the caller sends none. Fine on a
# laptop, wrong anywhere public: it would let anyone publish into this account.
# VOXEL_ALLOW_SERVER_KEY=1

# The parent name whose children are the services. Without it the agent uses
# PAYWALL_URL and takes each price from the 402 that states it.
VOXEL_ENS_PARENT=voxelbench.eth

# Any Sepolia endpoint. The public one is fine for reading names.
# SEPOLIA_RPC_URL=

# Which chain RecipeBook is settled on. Without it, hedera.
# VOXEL_LEDGER=arc

# The recipe catalog in Supabase, which the agent writes after each craft.
# Optional: without it the bench crafts as before. The secret key bypasses every
# access rule, so it lives here and nowhere else.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
