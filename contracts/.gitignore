# Compiler output at the package root, regenerated by `hardhat build`.
# Anchored with a leading slash: an unanchored artifacts/ also swallows
# ignition/deployments/*/artifacts/, which records what was actually deployed
# and is worth keeping.
/artifacts/
/cache/

# Ignition's per-deployment replay log. The addresses beside it are the part
# worth having; this only means something on the machine that produced it.
ignition/deployments/*/journal.jsonl
